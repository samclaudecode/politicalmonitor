# OpenRouter API key — used to call DeepSeek for policy-topic categorization.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for categorization (any OpenRouter model id works).
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Optional shared secret for the POST /api/ingest endpoint (recommended in production).
# When set, requests must send "Authorization: Bearer <secret>".
INGEST_SECRET=

# Where the SQLite database lives (defaults to ./data/politicalmonitor.db)
# DATABASE_PATH=./data/politicalmonitor.db
