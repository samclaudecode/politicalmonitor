# --- Database (Netlify Database / Postgres) ---
# On Netlify this is injected automatically once a database is attached to
# the site: the current Netlify Database sets NETLIFY_DB_URL; the legacy
# Neon extension sets NETLIFY_DATABASE_URL. Both are picked up automatically.
# For local dev, `netlify dev` injects it too, or set DATABASE_URL to any
# Postgres connection string.
# NETLIFY_DB_URL=postgres://...
# DATABASE_URL=postgres://user:pass@localhost:5432/politicalmonitor

# --- Feedbin (email → feed source) ---
# Subscribe to campaign mailing lists with your Feedbin address (@feedb.in);
# each sender becomes a feed in your account. Set your Feedbin login here to
# enable "Import feeds from Feedbin" on the Sources page and API-based
# ingestion of those emails.
FEEDBIN_EMAIL=
FEEDBIN_PASSWORD=
# FEEDBIN_API_URL=https://api.feedbin.com/v2

# --- OpenRouter (DeepSeek categorization) ---
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for categorization (any OpenRouter model id works).
OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324

# Optional shared secret for the POST /api/ingest endpoint (recommended in
# production). When set, requests must send "Authorization: Bearer <secret>".
INGEST_SECRET=
